# Local development only. Copy to .env and replace both placeholders.
# Keep values shell-compatible: use single quotes around passwords.
DB_HOST=localhost
MYSQL_HOST_PORT=3307
DB_PORT=3307
BACKEND_HOST_PORT=8080
DB_NAME=marketplace
# Application account; do not use root.
DB_USER=marketplace_app
DB_PASSWORD='REPLACE_WITH_LOCAL_APP_PASSWORD'
# Used only to initialize the MySQL administrator, never by Spring Boot.
MYSQL_ROOT_PASSWORD='REPLACE_WITH_DIFFERENT_LOCAL_ROOT_PASSWORD'
# Opcional, solo desarrollo: con `local` el backend crea la cuenta demo@marketplace.local (roles COMPRADOR y VENDEDOR)
# y el producto "Camiseta demo local", para probar compras y pedidos desde el frontend. No lo uses en despliegues.
# SPRING_PROFILES_ACTIVE=local

# Opcional (CU-18): correo de una cuenta con rol VENDEDOR. Al arrancar, si la tienda principal (id 1) no tiene dueña,
# se le asigna esa cuenta; si ya tiene, no cambia nada. Vacío por defecto. No lo combines con el perfil `local`, que
# ya asigna la tienda a la cuenta demo. Ver docs/swarm.md.
# MAIN_STORE_OWNER_EMAIL=vendedor@example.com

# Opcional, solo desarrollo (CU-24 y CU-25, seguimiento logístico): secreto con el que el servicio logístico firma cada
# actualización que envía al webhook (HMAC-SHA256); sin él el webhook queda cerrado. HAPPY_PATH hace avanzar por sí
# solo cada envío y cada devolución (Recogido, En camino, Entregado) cada STEP, para verlo en el frontend sin scripts.
# LOGISTICS_WEBHOOK_SECRET='REPLACE_WITH_LONG_RANDOM_SECRET'
# LOGISTICS_SIMULATED_SCRIPT=HAPPY_PATH
# LOGISTICS_SIMULATED_STEP=20s

# CU-08: SMTP compartido para verificación y recuperación. STARTTLS obligatorio, puerto 587.
# Configura credenciales reales solo en .env o en el entorno de despliegue, nunca en Git.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=marketplace
# SPRING_MAIL_PASSWORD='REPLACE_WITH_SMTP_SECRET'
# EMAIL_VERIFICATION_FROM=verification@example.com
# PASSWORD_RECOVERY_FROM=recovery@example.com
